  "useCases": [
    "编辑页面与文化机构"
  ],
  "avoid": [
    "全部正文都使用强调色"
  ],
  "constraints": [
    "同时提供文字、边界或图标状态，不能只靠颜色。",
    "迁移时替换为有使用权的素材与真实内容，来源快照的数值需按目标任务重新验证。"
  ],
  "composition": {
