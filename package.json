{
  "name": "personal-web-atlas",
  "version": "2.0.0",
  "private": true,
  "description": "Source-backed personal web design reference library",
  "scripts": {
    "start": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build.mjs && node scripts/build-static.mjs --assets=github",
    "build:local": "node scripts/build.mjs && node scripts/build-static.mjs --assets=local",
    "check": "node scripts/check.mjs",
    "atlas": "node scripts/atlas.mjs",
    "build:app": "node scripts/build-app.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "motion": "13.4.0",
    "lucide-react": "1.47.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tooltip": "1.2.16"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
